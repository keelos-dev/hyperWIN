+/// kRDPclient: the `tls-server-end-point` channel binding (RFC 5929) of each gateway host's TLS
+/// certificate, taken when the TLS connection is made (packet_io.rs) and put into NTLM's
+/// AUTHENTICATE (MsvAvChannelBindings), as Windows' own client does.
+static CHANNEL_BINDINGS: std::sync::Mutex<Option<std::collections::HashMap<String, Vec<u8>>>> =
+    std::sync::Mutex::new(None);
+
+/// Keeps the channel binding of `gw_host`'s certificate `der`.
+pub(crate) fn remember_channel_binding(gw_host: &str, der: &[u8]) {
+    use sha2::Digest as _;
+    // the certificate's own signature hash, SHA-256 for MD5 and SHA-1 (RFC 5929 4.1)
+    const SHA384: [&[u8]; 2] = [
+        &[0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0c],
+        &[0x2a, 0x86, 0x48, 0xce, 0x3d, 0x04, 0x03, 0x03],
+    ];
+    const SHA512: [&[u8]; 2] = [
+        &[0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0d],
+        &[0x2a, 0x86, 0x48, 0xce, 0x3d, 0x04, 0x03, 0x04],
+    ];
+    let has = |oids: &[&[u8]]| oids.iter().any(|oid| der.windows(oid.len()).any(|w| w == *oid));
+    let hash = if has(&SHA512) {
+        sha2::Sha512::digest(der).to_vec()
+    } else if has(&SHA384) {
+        sha2::Sha384::digest(der).to_vec()
+    } else {
+        sha2::Sha256::digest(der).to_vec()
+    };
+    let mut token = b"tls-server-end-point:".to_vec();
+    token.extend_from_slice(&hash);
+    if let Ok(mut map) = CHANNEL_BINDINGS.lock() {
+        map.get_or_insert_with(Default::default)
+            .insert(gw_host.to_ascii_lowercase(), token);
+    }
+}
+
+/// The channel binding for the gateway named in the SPN `HTTP/host`.
+fn channel_binding(target_name: Option<&str>) -> Option<Vec<u8>> {
+    let host = target_name?.strip_prefix("HTTP/")?.to_ascii_lowercase();
+    CHANNEL_BINDINGS.lock().ok()?.as_ref()?.get(&host).cloned()
+}
