+    /// write goes to the device while the rest of it is on the network).
+    fn process_partial(&mut self, _channel_id: u32, _total: usize, _received: &[u8]) -> PduResult<Vec<DvcMessage>> {
+        Ok(Vec::new())
+    }
+
     fn close(&mut self, _channel_id: u32) {}
 }
 
