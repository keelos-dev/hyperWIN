diff --git a/crates/ironrdp-rdpsnd-native/src/stats.rs b/crates/ironrdp-rdpsnd-native/src/stats.rs
new file mode 100644
index 00000000..bfdec302
--- /dev/null
+++ b/crates/ironrdp-rdpsnd-native/src/stats.rs
@@ -0,0 +1,171 @@
+//! krdp: what the playback backend did, for the application's statistics panel (kRDPclient).
+//!
+//! The backend (network side, Opus decode thread, real-time cpal callback) counts into atomics;
+//! the application reads a [`AudioSnapshot`] about once a second. Nothing here blocks the
+//! real-time thread: it only does relaxed atomic stores and adds.
+
+use core::sync::atomic::{AtomicU32, AtomicU64, Ordering};
+use std::sync::Mutex;
+
+use ironrdp_rdpsnd::pdu::{AudioFormat, WaveFormat};
+
+/// The format the server plays in now.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AudioFormatInfo {
+    /// "Opus", "PCM", or the wave format's number.
+    pub codec: &'static str,
+    pub sample_rate: u32,
+    pub channels: u16,
+    pub bits_per_sample: u16,
+}
+
+impl AudioFormatInfo {
+    fn of(format: &AudioFormat) -> Self {
+        let codec = if format.format == WaveFormat::OPUS {
+            "Opus"
+        } else if format.format == WaveFormat::PCM {
+            "PCM"
+        } else {
+            "other"
+        };
+        Self {
+            codec,
+            sample_rate: format.n_samples_per_sec,
+            channels: format.n_channels,
+            bits_per_sample: format.bits_per_sample,
+        }
+    }
+}
+
+/// A copy of the counters at one moment.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct AudioSnapshot {
+    /// The last format played (kept between sounds); None before the first.
+    pub format: Option<AudioFormatInfo>,
+    /// Wave data as received (Opus packets, or PCM), for the bit rate.
+    pub bytes_received: u64,
+    /// Wave PDUs received.
+    pub packets_received: u64,
+    /// Decoded (Opus) or passed on as they are (PCM) into the playback buffer.
+    pub packets_decoded: u64,
+    /// Not decodable, or (some of it) not fitting into the playback buffer.
+    pub packets_dropped: u64,
+    /// Opus decode time, total and the longest one, in microseconds.
+    pub decode_us_total: u64,
+    pub decode_us_max: u32,
+    /// Opus packets the decode time covers.
+    pub decode_count: u64,
+    /// Buffered before the device at its last callback, in microseconds.
+    pub buffered_us: u32,
+    /// The jitter buffer's target now (it grows after underruns), in microseconds.
+    pub target_us: u32,
+    /// Ran dry while playing.
+    pub underruns: u32,
+    /// Too much buffered, cut back to the target.
+    pub cuts: u32,
+}
+
+impl AudioSnapshot {
+    /// Average Opus decode time in microseconds; None before the first packet.
+    pub fn decode_us_avg(&self) -> Option<u64> {
+        self.decode_us_total.checked_div(self.decode_count)
+    }
+}
+
+/// The counters shared between the backend's threads and the application.
+#[derive(Debug, Default)]
+pub struct AudioStats {
+    format: Mutex<Option<AudioFormatInfo>>,
+    bytes_received: AtomicU64,
+    packets_received: AtomicU64,
+    packets_decoded: AtomicU64,
+    packets_dropped: AtomicU64,
+    decode_us_total: AtomicU64,
+    decode_us_max: AtomicU32,
+    decode_count: AtomicU64,
+    buffered_us: AtomicU32,
+    target_us: AtomicU32,
+    underruns: AtomicU32,
+    cuts: AtomicU32,
+}
+
+impl AudioStats {
+    pub fn snapshot(&self) -> AudioSnapshot {
+        let load = |a: &AtomicU64| a.load(Ordering::Relaxed);
+        AudioSnapshot {
+            format: self.format.lock().map(|f| *f).unwrap_or(None),
+            bytes_received: load(&self.bytes_received),
+            packets_received: load(&self.packets_received),
+            packets_decoded: load(&self.packets_decoded),
+            packets_dropped: load(&self.packets_dropped),
+            decode_us_total: load(&self.decode_us_total),
+            decode_us_max: self.decode_us_max.load(Ordering::Relaxed),
+            decode_count: load(&self.decode_count),
+            buffered_us: self.buffered_us.load(Ordering::Relaxed),
+            target_us: self.target_us.load(Ordering::Relaxed),
+            underruns: self.underruns.load(Ordering::Relaxed),
+            cuts: self.cuts.load(Ordering::Relaxed),
+        }
+    }
+
+    /// Zeroes the counters; the format and the buffer's level and target (what is current)
+    /// stay.
+    pub fn reset_counters(&self) {
+        for counter in [
+            &self.bytes_received,
+            &self.packets_received,
+            &self.packets_decoded,
+            &self.packets_dropped,
+            &self.decode_us_total,
+            &self.decode_count,
+        ] {
+            counter.store(0, Ordering::Relaxed);
+        }
+        for counter in [&self.decode_us_max, &self.underruns, &self.cuts] {
+            counter.store(0, Ordering::Relaxed);
+        }
+    }
+
+    pub(crate) fn set_format(&self, format: &AudioFormat) {
+        if let Ok(mut current) = self.format.lock() {
+            *current = Some(AudioFormatInfo::of(format));
+        }
+    }
+
+    pub(crate) fn received(&self, bytes: usize) {
+        self.packets_received.fetch_add(1, Ordering::Relaxed);
+        self.bytes_received
+            .fetch_add(u64::try_from(bytes).unwrap_or(u64::MAX), Ordering::Relaxed);
+    }
+
+    pub(crate) fn decoded(&self) {
+        self.packets_decoded.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub(crate) fn dropped(&self) {
+        self.packets_dropped.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub(crate) fn decode_time(&self, us: u64) {
+        self.decode_count.fetch_add(1, Ordering::Relaxed);
+        self.decode_us_total.fetch_add(us, Ordering::Relaxed);
+        self.decode_us_max
+            .fetch_max(u32::try_from(us).unwrap_or(u32::MAX), Ordering::Relaxed);
+    }
+
+    pub(crate) fn level(&self, buffered_us: u32) {
+        self.buffered_us.store(buffered_us, Ordering::Relaxed);
+    }
+
+    pub(crate) fn target(&self, target_us: u32) {
+        self.target_us.store(target_us, Ordering::Relaxed);
+    }
+
+    pub(crate) fn underrun(&self) {
+        self.underruns.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub(crate) fn cut(&self) {
+        self.cuts.fetch_add(1, Ordering::Relaxed);
+    }
+}
