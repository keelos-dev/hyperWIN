+    /// krdp: as `new`, with the client's underrun counter and statistics on the backend.
+    pub(crate) fn with_krdp(
+        config: &AudioConfig,
+        underruns: Option<Arc<core::sync::atomic::AtomicU32>>,
+        stats: Option<Arc<ironrdp_rdpsnd_native::stats::AudioStats>>,
+    ) -> Self {
+        let mut backend = RdpsndBackend::with_config(config.playback());
+        if let Some(counter) = underruns {
+            backend = backend.with_underruns(counter);
+        }
+        if let Some(stats) = stats {
+            backend = backend.with_stats(stats);
+        }
